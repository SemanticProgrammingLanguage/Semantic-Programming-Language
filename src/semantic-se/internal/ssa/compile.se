d = 0 type_origin = "inferred" type_ref = object { kind = "string" type_origin = "inferred" } } id = 1348 semantic_facets = list [ "UASF_0225" ] source_span = object { end_column = 15 end_line = 283 end_offset = 7774 file = "C:\\PROGRA~1\\Go\\src\\cmd\\compile\\internal\\ssa\\compile.go" start_column = 10 start_line = 276 start_offset = 7640 } structural_kind = "OperationExpr" } object { fields = object { id = 1348 kind = "literal" operation = object { literal_kind = "string" semantics = object { confidence = "exact" } text = "`PhaseOptions usage:\n\n    go tool compile -d=ssa/<phase>/<flag>[=<value>|<function_name>]\n\nwhere:\n\n- <phase> is one of:\n`" } scope_id = 0 type_origin = "inferred" type_ref = object { kind = "string" type_origin = "inferred" } value = object { literal_kind = "string" text = "`PhaseOptions usage:\n\n    go tool compile -d=ssa/<phase>/<flag>[=<value>|<function_name>]\n\nwhere:\n\n- <phase> is one of:\n`" } } id = 1349 semantic_facets = list [ "UASF_0224" ] source_span = object { end_column = 2 end_line = 283 end_offset = 7761 file = "C:\\PROGRA~1\\Go\\src\\cmd\\compile\\internal\\ssa\\compile.go" start_column = 10 start_line = 276 start_offset = 7640 } structural_kind = "LiteralExpr" } object { fields = object { id = 1349 kind = "identifier" name = "native_var_phasenames" operation = object { semantics = object { confidence = "exact" } } scope_id = 0 type_origin = "inferred" type_ref = object { kind = "string" type_origin = "inferred" } } id = 1350 semantic_facets = list [ "UASF_0219" ] source_span = object { end_column = 15 end_line = 283 end_offset = 7774 file = "C:\\PROGRA~1\\Go\\src\\cmd\\compile\\internal\\ssa\\compile.go" start_column = 5 start_line = 283 start_offset = 7764 } structural_kind = "SymbolRef" } object { fields = object { id = 1350 kind = "literal" operation = object { literal_kind = "string" semantics = object { confidence = "exact" } text = "`\n\n- <flag> is one of:\n    on, off, debug, mem, time, test, stats, dump, seed\n\n- <value> defaults to 1\n\n- <function_name> is required for the \"dump\" flag, and specifies the\n  name of function to dump after <phase>\n\nPhase \"all\" supports flags \"time\", \"mem\", and \"dump\".\nPhase \"intrinsics\" supports flags \"on\", \"off\", and \"debug\".\nPhase \"genssa\" (assembly generation) supports the flag \"dump\".\n\nIf the \"dump\" flag is specified, the output is written on a file named\n<phase>__<function_name>_<seq>.dump; otherwise it is directed to stdout.\n\nExamples:\n\n    -d=ssa/check/on\nenables checking after each phase\n\n\t-d=ssa/check/seed=1234\nenables checking after each phase, using 1234 to seed the PRNG\nused for value order randomization\n\n    -d=ssa/all/time\nenables time reporting for all phases\n\n    -d=ssa/prove/debug=2\nsets debugging level to 2 in the prove pass\n\nBe aware that when \"/debug=X\" is applied to a pass, some passes\nwill emit debug output for all functions, and other passes will\nonly emit debug output for functions that match the current\nGOSSAFUNC value.\n\nMultiple flags can be passed at once, by separating them with\ncommas. For example:\n\n    -d=ssa/check/on,ssa/all/time\n`" } scope_id = 0 type_origin = "inferred" type_ref = object { kind = "string" type_origin = "inferred" } value = object { literal_kind = "string" text = "`\n\n- <flag> is one of:\n    on, off, debug, mem, time, test, stats, dump, seed\n\n- <value> defaults to 1\n\n- <function_name> is required for the \"dump\" flag, and specifies the\n  name of function to dump after <phase>\n\nPhase \"all\" supports flags \"time\", \"mem\", and \"dump\".\nPhase \"intrinsics\" supports flags \"on\", \"off\", and \"debug\".\nPhase \"genssa\" (assembly generation) supports the flag \"dump\".\n\nIf the \"dump\" flag is specified, the output is written on a file named\n<phase>__<function_name>_<seq>.dump; otherwise it is directed to stdout.\n\nExamples:\n\n    -d=ssa/check/on\nenables checking after each phase\n\n\t-d=ssa/check/seed=1234\nenables checking after each phase, using 1234 to seed the PRNG\nused for value order randomization\n\n    -d=ssa/all/time\nenables time reporting for all phases\n\n    -d=ssa/prove/debug=2\nsets debugging level to 2 in the prove pass\n\nBe aware that when \"/debug=X\" is applied to a pass, some passes\nwill emit debug output for all functions, and other passes will\nonly emit debug output for functions that match the current\nGOSSAFUNC value.\n\nMultiple flags can be passed at once, by separating them with\ncommas. For example:\n\n    -d=ssa/check/on,ssa/all/time\n`" } } id = 1351 semantic_facets = list [ "UASF_0224" ] source_span = object { end_column = 2 end_line = 324 end_offset = 8957 file = "C:\\PROGRA~1\\Go\\src\\cmd\\compile\\internal\\ssa\\compile.go" start_column = 18 start_line = 283 start_offset = 7777 } structural_kind = "LiteralExpr" } object { fields = object { binding_refs = list [ 79 ] branches = list [ object { reference = object { domain = "node" id = "1356" } role = "then" } ] condition = object { domain = "node" id = "1353" } effects = list [ "local.read" ] id = 1351 kind = "if" operation = object { semantics = object { confidence = "exact" } } scope_id = 0 type_origin = "inferred" type_ref = object { kind = "string" type_origin = "inferred" } } id = 1352 semantic_facets = list [ "UASF_0182" ] source_span = object { end_column = 3 end_line = 343 end_offset = 9340 file = "C:\\PROGRA~1\\Go\\src\\cmd\\compile\\internal\\ssa\\compile.go" start_column = 2 start_line = 327 start_offset = 8963 } structural_kind = "IfStmt" } object { fields = object { id = 1352 kind = "binary" operands = list [ object { reference = object { domain = "node" id = "1354" } role = "left" } object { reference = object { domain = "node" id = "1355" } role = "right" } ] operation = object { operator = "==" semantics = object { confidence = "exact" } } scope_id = 0 type_origin = "inferred" type_ref = object { kind = "boolean" type_origin = "inferred" } } id = 1353 semantic_facet