#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE="$ROOT/bin/msplc-core"
VERSION="1.0.0"

show_help() {
cat <<'TXT'
MSPLC - Minimal Semantic Programming Language Compiler

Usage:
  msplc compile <input.se> [more.se ...] -o <output>
  msplc help
  msplc version

Commands:
  compile   Compile one or more Semantic .se units with the minimal
            selfhost.x64.v2 backend to a Linux x86-64 ELF executable.
  help      Show this help.
  version   Show the MSPLC version.

Examples:
  ./msplc compile src/*.se -o msplc-next
  ./msplc version
TXT
}

cmd="${1:-help}"
case "$cmd" in
  help|-h|--help)
    show_help
    ;;
  version|-V|--version)
    echo "msplc $VERSION"
    ;;
  compile)
    shift
    inputs=()
    output=""
    while (($#)); do
      case "$1" in
        -o|--output)
          shift
          (($#)) || { echo "msplc: missing output after -o" >&2; exit 2; }
          output="$1"
          ;;
        *.se)
          inputs+=("$1")
          ;;
        *)
          echo "msplc: unsupported argument: $1" >&2
          exit 2
          ;;
      esac
      shift
    done
    ((${#inputs[@]})) || { echo "msplc: no .se input supplied" >&2; exit 2; }
    [[ -n "$output" ]] || { echo "msplc: missing -o <output>" >&2; exit 2; }
    for f in "${inputs[@]}"; do
      [[ -f "$f" ]] || { echo "msplc: input not found: $f" >&2; exit 2; }
    done
    "$CORE" "${inputs[@]}" "$output"
    chmod +x "$output" 2>/dev/null || true
    ;;
  *)
    echo "msplc: unknown command: $cmd" >&2
    show_help >&2
    exit 2
    ;;
esac
